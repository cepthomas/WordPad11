IDD_FORMAT_PARA DIALOG 0, 0, 239, 146
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Paragraph"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Indentation",IDC_BOX,7,7,114,75
    LTEXT           "&Left:",IDC_STATIC,13,21,29,8
    EDITTEXT        IDC_EDIT_LEFT,52,19,60,14,ES_AUTOHSCROLL
    LTEXT           "&Right:",IDC_STATIC,13,42,29,8,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_RIGHT,52,40,60,14,ES_AUTOHSCROLL
    LTEXT           "&First line:",IDC_STATIC,13,63,32,8,NOT WS_GROUP
    EDITTEXT        IDC_EDIT_FIRST_LINE,52,60,60,14,ES_AUTOHSCROLL
    LTEXT           "Ali&gnment:",IDC_TEXT_ALIGNMENT,126,70,37,8
    COMBOBOX        IDC_COMBO_ALIGNMENT,165,68,60,45,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Page Brea&k Before",IDC_CHECK_PAGEBREAK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,126,49,76,10
    DEFPUSHBUTTON   "OK",IDOK,182,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,182,24,50,14
    LTEXT           "&Before:",IDC_STATIC,13,102,38,8
    EDITTEXT        IDC_EDIT_BEFORE,52,100,60,14,ES_AUTOHSCROLL
    CONTROL         "Spin2",IDC_SPIN_BEFORE,"msctls_updown32",UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,106,95,11,11
    LTEXT           "&After:",IDC_STATIC,13,120,38,8
    EDITTEXT        IDC_EDIT_AFTER,52,119,60,14,ES_AUTOHSCROLL
    CONTROL         "Spin3",IDC_SPIN_AFTER,"msctls_updown32",UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,105,108,11,16
    GROUPBOX        "Spacing",IDC_STATIC,7,88,225,50
END

